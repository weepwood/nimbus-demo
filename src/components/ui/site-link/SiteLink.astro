---
/**
 * Site-root links for MDX and custom pages.
 * Use logical routes ("/quickstart/"), never hard-code an Astro base path.
 */
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
}

const { href, ...rest } = Astro.props;
const resolvedHref = href.startsWith("/") && !href.startsWith("//")
  ? withBase(href, import.meta.env.BASE_URL)
  : href;
---
<a href={resolvedHref} {...rest}><slot /></a>
